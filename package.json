{
  "name": "@crcatala/strong-cli",
  "version": "0.1.1",
  "description": "Unofficial read-only CLI for Strong Workout Tracker (strong.app)",
  "license": "MIT",
  "author": "Christian Catalan",
  "packageManager": "npm@11.16.0",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "strong",
    "strong-app",
    "workout",
    "fitness",
    "gym",
    "cli"
  ],
  "homepage": "https://github.com/crcatala/strong-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crcatala/strong-cli.git"
  },
  "bugs": {
    "url": "https://github.com/crcatala/strong-cli/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "strong": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "bun src/cli.ts",
    "dev:tsx": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "node scripts/require-live-test-env.mjs && vitest run tests/live --no-file-parallelism",
    "test:package": "bash scripts/test-package.sh",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "verify": "npm run build && npm test && npm run lint && npm run test:package",
    "release": "release-it",
    "release:dry": "release-it --dry-run --no-npm --no-github",
    "release:first": "release-it --first-release",
    "release:prep": "bash scripts/prep-release.sh",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^14.0.0",
    "kleur": "^4.1.5"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@release-it/keep-a-changelog": "^8.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "release-it": "^21.0.1",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "keytar@7.9.0": true
  }
}
